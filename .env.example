# ---- Nebius Token Factory (required for model reasoning) -------------------
# Create a key at https://tokenfactory.nebius.com
NEBIUS_API_KEY=

# Model ids. Copy the exact strings from the Token Factory catalog if they change.
TELLTALE_REASONING_MODEL=nvidia/nemotron-3-super-120b-a12b
TELLTALE_FAST_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# Token Factory has no Nemotron vision model, so screenshots are transcribed by MiniCPM-V.
# Everything that decides the verdict runs on Nemotron.
TELLTALE_VISION_MODEL=openbmb/MiniCPM-V-4_5

# Nemotron 3 reasoning mode per step: off, low or on.
TELLTALE_THINKING_CONTEXT=off
TELLTALE_THINKING_CLASSIFY=off
TELLTALE_THINKING_VERDICT=low
TELLTALE_THINKING_ACTION=off

# Optional second opinion for medium-risk verdicts, e.g. a Nemotron 3 Ultra id from the
# catalog. Leave empty to turn it off.
TELLTALE_ESCALATION_MODEL=

# ---- Tavily (optional, powers live verification) ---------------------------
# Without it the app still runs and says the online check was skipped.
TAVILY_API_KEY=

# ---- Runtime ----------------------------------------------------------------
TELLTALE_LLM_TIMEOUT=45
TELLTALE_LLM_STAGE_BUDGET=75
TELLTALE_TAVILY_TIMEOUT=15
TELLTALE_CACHE_TTL_S=900
# Cost guards for a public deployment.
TELLTALE_RATE_LIMIT_PER_IP=20
TELLTALE_RATE_LIMIT_WINDOW_S=600
TELLTALE_DAILY_MODEL_BUDGET=800
# Comma-separated origins if the frontend is hosted elsewhere.
TELLTALE_CORS_ORIGINS=*
