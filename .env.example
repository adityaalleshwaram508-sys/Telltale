# ---- Nebius Token Factory (required) ---------------------------------------
# Grab a key from https://tokenfactory.nebius.com -> API keys
NEBIUS_API_KEY=

# Model IDs. Defaults are the current Nemotron line-up on Token Factory, but
# copy the exact string from the model catalog if these drift — the "-a12b"
# style suffixes change between releases.
#   reasoning workhorse (verdict synthesis, classification)
TELLTALE_REASONING_MODEL=nvidia/nemotron-3-super-120b-a12b
#   cheap/fast model for the small structured extraction steps
TELLTALE_FAST_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
#   vision-language model for reading screenshots. Token Factory currently has
#   no Nemotron VL model, so we use MiniCPM-V (a strong OCR/vision model).
#   Alternative on Token Factory: google/gemma-3-27b-it. All reasoning stays on
#   Nemotron regardless of this setting.
TELLTALE_VISION_MODEL=openbmb/MiniCPM-V-4_5

# ---- Tavily (optional but recommended — powers live verification) ----------
# Without this key the app still runs; it just skips the live-research step
# and says so in the verdict instead of pretending it checked.
TAVILY_API_KEY=

# ---- Runtime knobs ---------------------------------------------------------
TELLTALE_LLM_TIMEOUT=60
TELLTALE_TAVILY_TIMEOUT=15
# Comma-separated origins for CORS if you host the frontend separately.
TELLTALE_CORS_ORIGINS=*
